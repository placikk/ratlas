{
  "name": "ratlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "pwa-assets-generator --preset minimal-2023 public/logo.svg",
    "db:start": "supabase start -x realtime,imgproxy,studio,logflare,vector,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "deploy": "npm run build && wrangler deploy",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "smoke": "node scripts/smoke-sighting.mjs",
    "eval": "tsx --env-file=supabase/functions/.env scripts/eval-verifier.ts eval",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "i18next": "^26.4.2",
    "maplibre-gl": "^6.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "supabase": "^2.118.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0",
    "zod": "^4.6.5"
  }
}
